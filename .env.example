# Copy to .env for local dev. For store builds set these as EAS environment
# variables (production environment):  eas env:create --environment production ...
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional — Google sign-in is hidden until these are set (Google Cloud → Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional — analytics are disabled when blank
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional overrides — defaults are the GitHub Pages site built from docs/
EXPO_PUBLIC_TERMS_URL=https://amitd01.github.io/bookdate/terms/
EXPO_PUBLIC_PRIVACY_URL=https://amitd01.github.io/bookdate/privacy/
EXPO_PUBLIC_SUPPORT_EMAIL=amitdas+bookdatesupport@gmail.com
