# Copy to .env for local dev. For store builds set these as EAS environment
# variables (production environment):  eas env:create --environment production ...
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional — analytics are disabled when blank
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Public URLs of the hosted legal docs (docs/terms.md, docs/privacy.md)
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=support@bookdate.app
